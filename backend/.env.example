# Backend — SERVER-SIDE SECRETS. Never shipped to the app, never committed.
# Copy this file to `backend/.env` (gitignored) and fill in your values.
# IMPORTANT: rotate any keys that were ever pasted into chat before using them.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=

# Venue data source: true = deterministic mock adapter (demo-safe, no key needed).
# Set to false only once GOOGLE_PLACES_API_KEY is a verified, working key.
USE_MOCK_VENUES=true

PORT=3001
