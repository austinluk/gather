# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# local npm registry config (machine/network-specific)
.npmrc

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files (secrets — never commit; .env.example templates ARE committed)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
